#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include "validaciones.h"

void mensaje_error(const char *texto)
{
    printf("  [ERROR] %s\n", texto);
}

/*
 * Lee una linea de stdin en 'buffer' (sin el salto de linea).
 * Devuelve 1 si entro completa y 0 si era demasiado larga (descarta el resto
 * para no dejar basura en el buffer). Si se cierra la entrada (EOF) termina
 * el programa de forma ordenada para evitar un bucle infinito.
 */
static int leer_linea(char *buffer, size_t tam)
{
    size_t largo;
    int c;

    if (fgets(buffer, (int)tam, stdin) == NULL) {
        printf("\n");
        mensaje_error("Se cerro la entrada de datos. Fin del programa.");
        exit(EXIT_FAILURE);
    }

    largo = strlen(buffer);
    if (largo > 0 && buffer[largo - 1] == '\n') {
        buffer[largo - 1] = '\0';
        return 1;
    }
    if (feof(stdin)) {
        return 1;               /* ultima linea sin salto de linea */
    }
    while ((c = getchar()) != '\n' && c != EOF) {
        /* descarta lo que sobra de la linea */
    }
    return 0;
}

/* Quita espacios y '\r' al inicio y al final. Devuelve el primer caracter util. */
static char *recortar(char *texto)
{
    char *fin;

    while (*texto != '\0' && isspace((unsigned char)*texto)) {
        texto++;
    }
    fin = texto + strlen(texto);
    while (fin > texto && isspace((unsigned char)*(fin - 1))) {
        fin--;
    }
    *fin = '\0';
    return texto;
}

int es_numero(const char *texto, int admite_decimal)
{
    size_t k;
    size_t largo = strlen(texto);
    int puntos = 0;
    int digitos = 0;
    int valido = (largo > 0);

    for (k = 0; k < largo && valido; k++) {
        switch (texto[k]) {
        case '0': case '1': case '2': case '3': case '4':
        case '5': case '6': case '7': case '8': case '9':
            digitos++;
            break;
        case '.':
        case ',':
            if (admite_decimal) {
                puntos++;
            } else {
                valido = 0;
            }
            break;
        case '+':
        case '-':
            if (k != 0) {
                valido = 0;
            }
            break;
        default:
            valido = 0;
        }
    }
    return valido && (puntos <= 1) && (digitos > 0);
}

double leer_numero(const char *mensaje, double minimo, double maximo, int solo_entero)
{
    char linea[LONG_TEXTO];
    char *texto;
    char *coma;
    double valor = 0.0;
    int valido;

    do {
        printf("%s", mensaje);
        fflush(stdout);
        valido = 0;

        if (!leer_linea(linea, sizeof linea)) {
            mensaje_error("La entrada es demasiado larga.");
            continue;
        }
        texto = recortar(linea);

        if (!es_numero(texto, !solo_entero)) {
            mensaje_error("No es un numero valido.");
        } else {
            coma = strchr(texto, ',');          /* acepta coma o punto decimal */
            if (coma != NULL) {
                *coma = '.';
            }
            valor = strtod(texto, NULL);
            if (valor < minimo || valor > maximo) {
                mensaje_error("Valor fuera de rango.");
            } else {
                valido = 1;
            }
        }
    } while (!valido);

    return valor;
}

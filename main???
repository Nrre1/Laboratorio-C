#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include "artemis.h"
#include "validaciones.h"

static void mostrar_menu(void)
{
    printf("\nSIMULADOR ARTEMIS \n");
    printf("1. Configurar parametros (altitud y masa)\n");
    printf("2. Mostrar orbita LEO\n");
    printf("3. Simular pulso lateral\n");
    printf("4. Simulacion por turnos (juego)\n");
    printf("5. Reporte final\n");
    printf("0. Salir\n");
}

int main(void)
{
    DatosOrbita  orbita;
    DatosPulso   pulso;
    Reporte      reportes[MAX_REPORTES];
    Turno        turnos[MAX_TURNOS];
    ResumenJuego resumen;
    int cantidad_reportes = 0;
    int cantidad_turnos   = 0;
    int opcion;
    double aceleracion_ingresada;
    double tiempo_ingresado;

    srand((unsigned)time(NULL));

    memset(&orbita, 0, sizeof orbita);
    memset(&pulso, 0, sizeof pulso);
    memset(&resumen, 0, sizeof resumen);

    orbita.altitud = H_DEFECTO;
    orbita.masa    = MASA_DEFECTO;
    calcular_orbita(&orbita);
    resumen.resultado = JUEGO_NO_JUGADO;

    do {
        mostrar_menu();
        opcion = (int)leer_numero("Seleccione una opcion: ", 0, 5, 1);

        switch (opcion) {
        case 1:
            configurar_parametros(&orbita);
            break;

        case 2:
            mostrar_resultados_orbita(&orbita);
            break;

        case 3:
            if ((int)leer_numero("Usar valores del enunciado (a=0,50 m/s2, dt=10 s)? 1 = si, 2 = no: ",
                                 1, 2, 1) == 1) {
                aceleracion_ingresada = A_PULSO_DEFECTO;
                tiempo_ingresado      = T_PULSO_DEFECTO;
            } else {
                aceleracion_ingresada = leer_numero("Aceleracion lateral [m/s2] (0.01 - 5): ",
                                                    0.01, 5, 0);
                tiempo_ingresado      = leer_numero("Duracion del pulso [s] (0.1 - 60): ",
                                                    0.1, 60, 0);
            }
            calcular_pulso(orbita.velocidad_orbital, orbita.radio_orbital,
                           aceleracion_ingresada, tiempo_ingresado, &pulso);
            mostrar_resultados_pulso(&pulso);
            guardar_reporte(reportes, &cantidad_reportes, &orbita, &pulso);
            break;

        case 4:
            simular_juego(&orbita, turnos, &cantidad_turnos, &resumen);
            break;

        case 5:
            mostrar_reporte_final(reportes, cantidad_reportes,
                                  turnos, cantidad_turnos, &resumen);
            break;

        case 0:
            printf("Mision finalizada.\n");
            break;
        }
    } while (opcion != 0);

    return 0;
}

Accion SimuladorArtemis_Escenario2 es
    Ambiente
        // 1. Constantes físicas (las declaramos como variables para el pseudocódigo)
        G, MASA_TIERRA, RADIO_TIERRA, ALTITUD_LEO, RADIO_ORBITAL, MASA_ORION: Real
        PI: Real
        
        // 2. Estructura de datos
        NaveOrion = registro
            masa: Real
            altitud: Real
            radio_orbital: Real
            velocidad_orbital: Real
            periodo_segundos: Real
            periodo_minutos: Real
            aceleracion_centripeta: Real
            desviacion_lateral: Real
        FinRegistro
        
        // Variable principal (parámetro actual)
        miNave: NaveOrion

        // 3. Kit de Procedimientos
        // Usamos 'var' para que los cálculos se guarden en la estructura original
        Procedimiento InicializarNave(var nave: NaveOrion) es
            nave.masa := MASA_ORION
            nave.altitud := ALTITUD_LEO
            nave.radio_orbital := RADIO_ORBITAL
            nave.velocidad_orbital := 0.0
            nave.periodo_segundos := 0.0
            nave.periodo_minutos := 0.0
            nave.aceleracion_centripeta := 0.0
            nave.desviacion_lateral := 0.0
        FinProcedimiento

        Procedimiento CalcularVelocidad(var nave: NaveOrion) es
            // Fuerza gravitatoria actúa como centrípeta: v = RAIZ(G * M / r)
            nave.velocidad_orbital := RAIZ((G * MASA_TIERRA) / nave.radio_orbital)
        FinProcedimiento

        Procedimiento CalcularPeriodo(var nave: NaveOrion) es
            // MCU: T = (2 * PI * r) / v
            nave.periodo_segundos := (2 * PI * nave.radio_orbital) / nave.velocidad_orbital
            nave.periodo_minutos := nave.periodo_segundos / 60.0
        FinProcedimiento

        Procedimiento CalcularAceleracion(var nave: NaveOrion) es
            // ac = v^2 / r
            nave.aceleracion_centripeta := (nave.velocidad_orbital * nave.velocidad_orbital) / nave.radio_orbital
        FinProcedimiento

        Procedimiento CalcularDesviacion(var nave: NaveOrion; a_lateral: Real; t_pulso: Real) es
            // MRUV perpendicular a la órbita: d = 0.5 * a * t^2
            nave.desviacion_lateral := 0.5 * a_lateral * (t_pulso * t_pulso)
        FinProcedimiento

    Proceso
        // Inicialización de las variables globales (constantes)
        G := 6.674E-11
        MASA_TIERRA := 5.972E24
        RADIO_TIERRA := 6371000.0
        ALTITUD_LEO := 192000.0
        RADIO_ORBITAL := 6563000.0
        MASA_ORION := 33000.0
        PI := 3.141592

        ESCRIBIR("--- MISION ARTEMIS: INSERCION LEO ---")
        
        // 1. Inicializamos la nave (equivalente a pasar el puntero en C)
        InicializarNave(miNave)
        
        // 2. Respuesta A: Velocidad Orbital
        CalcularVelocidad(miNave)
        ESCRIBIR("A. Velocidad orbital (v): ", miNave.velocidad_orbital, " m/s")
        
        // 3. Respuesta B: Período
        CalcularPeriodo(miNave)
        ESCRIBIR("B. Período orbital (T): ", miNave.periodo_segundos, " s (", miNave.periodo_minutos, " min)")
        
        // 4. Respuesta C: Aceleración
        CalcularAceleracion(miNave)
        ESCRIBIR("C. Aceleración centrípeta: ", miNave.aceleracion_centripeta, " m/s^2")
        
        // 5. Respuesta D: Desviación (pasamos 0.50 m/s^2 y 10.0 s por parámetro)
        CalcularDesviacion(miNave, 0.50, 10.0)
        ESCRIBIR("D. Desviación lateral tras 10s: ", miNave.desviacion_lateral, " m")
        
    FinProceso
FinAccion
